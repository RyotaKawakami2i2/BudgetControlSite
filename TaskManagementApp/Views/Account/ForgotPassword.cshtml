@{
    ViewData["Title"] = "パスワードリセット申請";
}
<div class="register-bg">
    <div class="col-12 col-md-6 col-lg-5 mx-auto">
        <div class="card register-card p-4">
            <div class="text-center">
                <div class="register-icon">
                    <i class="fas fa-key"></i>
                </div>
                <h2 class="mb-4 fw-bold">パスワードリセット申請</h2>
                <p class="text-muted mb-4">ご登録のメールアドレスを入力してください。<br>リセット用リンクをメールで送信します。</p>
            </div>
            @if (ViewBag.Error != null)
            {
                <div class="alert-enhanced alert-danger-enhanced">
                    <i class="fas fa-exclamation-triangle alert-icon"></i>
                    <div>
                        <strong>エラー</strong>
                        <p class="mb-0">@ViewBag.Error</p>
                    </div>
                </div>
            }
            @if (ViewBag.Message != null)
            {
                <div class="alert-enhanced alert-success-enhanced">
                    <i class="fas fa-check-circle alert-icon"></i>
                    <div>
                        <strong>送信完了</strong>
                        <p class="mb-0">@ViewBag.Message</p>
                    </div>
                </div>
            }
            <form method="post" autocomplete="on">
                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold">メールアドレス</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input type="email" class="form-control" id="email" name="email" required placeholder="your@email.com" />
                    </div>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-register">
                        <i class="fas fa-paper-plane me-2"></i>リセットリンクを送信
                    </button>
                    <a href="@Url.Action("Login", "Account")" class="btn-login-link text-center">
                        <i class="fas fa-sign-in-alt me-2"></i>ログイン画面へ戻る
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script></script>
} 