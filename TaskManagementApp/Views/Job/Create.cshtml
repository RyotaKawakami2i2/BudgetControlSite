@model TaskManagementApp.Models.Job
@{
    ViewData["Title"] = "ジョブ登録";
}

<div class="job-create-bg">
    <div class="container">
        <div class="job-create-container">
            <div class="job-create-header">
                <div class="job-create-title">
                    <div class="job-create-title-icon">
                        <i class="fas fa-plus-circle"></i>
                    </div>
                    ジョブ登録
                </div>
                <div class="job-create-subtitle">新しいジョブを作成してプロジェクトを管理しましょう</div>
            </div>
            
            <div class="job-create-body">
                <form method="post" autocomplete="on" class="job-create-form">
                    <div class="form-section">
                        <div class="form-section-header">
                            <i class="fas fa-info-circle"></i>
                            基本情報
                        </div>
                        <div class="form-section-body">
                            <div class="form-group">
                                <label for="Title" class="form-label">
                                    <i class="fas fa-tasks"></i> タイトル
                                </label>
                                <input type="text" class="form-control" id="Title" name="Title" required 
                                       placeholder="ジョブのタイトルを入力してください" />
                            </div>
                            
                            <div class="form-group">
                                <label for="Description" class="form-label">
                                    <i class="fas fa-align-left"></i> 説明
                                </label>
                                <textarea class="form-control" id="Description" name="Description" required 
                                          placeholder="ジョブの詳細な説明を入力してください" rows="4"></textarea>
                            </div>
                            
                            <div class="form-group">
                                <label for="Category" class="form-label">
                                    <i class="fas fa-tag"></i> カテゴリ
                                </label>
                                <input type="text" class="form-control" id="Category" name="Category" 
                                       placeholder="カテゴリを入力してください（任意）" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-section">
                        <div class="form-section-header">
                            <i class="fas fa-calendar-alt"></i>
                            スケジュール
                        </div>
                        <div class="form-section-body">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="ScheduledStart" class="form-label">
                                        <i class="fas fa-calendar-plus"></i> 予定開始日
                                    </label>
                                    <input type="date" class="form-control" id="ScheduledStart" name="ScheduledStart" required />
                                </div>
                                
                                <div class="form-group">
                                    <label for="ScheduledEnd" class="form-label">
                                        <i class="fas fa-calendar-check"></i> 予定終了日
                                    </label>
                                    <input type="date" class="form-control" id="ScheduledEnd" name="ScheduledEnd" required />
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label for="ScheduledHours" class="form-label">
                                    <i class="fas fa-clock"></i> 予定工数（時間）
                                </label>
                                <input type="number" step="0.1" class="form-control" id="ScheduledHours" name="ScheduledHours" required 
                                       placeholder="予定工数を入力してください" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-section">
                        <div class="form-section-header">
                            <i class="fas fa-cog"></i>
                            設定
                        </div>
                        <div class="form-section-body">
                            <div class="form-group">
                                <label for="ParentJobId" class="form-label">
                                    <i class="fas fa-sitemap"></i> 親ジョブ（任意）
                                </label>
                                <select class="form-control" id="ParentJobId" name="ParentJobId">
                                    <option value="">-- 親ジョブなし --</option>
                                    @{
                                        var parentJobs = ViewBag.ParentJobs as IEnumerable<dynamic> ?? new List<dynamic>();
                                    }
                                    @foreach (var parent in parentJobs)
                                    {
                                        var isSelected = (Model?.ParentJobId ?? 0) == (parent.Id ?? 0);
                                        <option value="@parent.Id" selected="@isSelected">@parent.Title</option>
                                    }
                                </select>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="Status" class="form-label">
                                        <i class="fas fa-flag"></i> ステータス
                                    </label>
                                    <select class="form-control" id="Status" name="Status">
                                        @foreach (var s in (List<string>)ViewBag.StatusList)
                                        {
                                            var isSelected = (Model?.Status ?? "") == s;
                                            <option value="@s" selected="@isSelected">@s</option>
                                        }
                                    </select>
                                </div>
                                
                                <div class="form-group">
                                    <label for="Priority" class="form-label">
                                        <i class="fas fa-star"></i> 優先度
                                    </label>
                                    <select class="form-control" id="Priority" name="Priority">
                                        @foreach (var p in (List<string>)ViewBag.PriorityList)
                                        {
                                            var isSelected = (Model?.Priority ?? "") == p;
                                            <option value="@p" selected="@isSelected">@p</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-actions">
                        <a href="@Url.Action("Index", "Job")" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> 一覧へ戻る
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> 登録
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>
} 