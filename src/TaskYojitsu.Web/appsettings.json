{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "BaseUrl": "https://tasks.corp.example",
    "TimeZone": "Asia/Tokyo"
  },
  "Security": {
    "Cookies": {
      "Secure": true
    },
    "Session": {
      "IdleMinutes": 30,
      "AbsoluteHours": 12,
      "WarningMinutes": 5,
      "TouchIntervalSeconds": 60
    },
    "Reauth": {
      "Minutes": 10
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Minutes": 15
    },
    "Password": {
      "MinLength": 15,
      "MaxLength": 128,
      "Pbkdf2Iterations": 300000,
      "PwnedApi": {
        "Enabled": false,
        "ProxyUrl": ""
      }
    },
    "Totp": {
      "AllowedSkewSteps": 1
    },
    "Mfa": {
      "RequiredForAdmins": false
    },
    "Invitation": {
      "ValidHours": 72
    },
    "PasswordReset": {
      "ValidMinutes": 30
    },
    "AdminAllowedNetworks": [],
    "KnownProxies": [],
    "NewDeviceLookbackDays": 90
  },
  "RateLimits": {
    "LoginByIp": { "Permits": 10, "WindowSeconds": 60 },
    "LoginByEmail": { "Permits": 10, "WindowSeconds": 900 },
    "SecondFactorByIp": { "Permits": 10, "WindowSeconds": 60 },
    "ResetRequestByIp": { "Permits": 5, "WindowSeconds": 3600 },
    "ResetRequestByEmail": { "Permits": 3, "WindowSeconds": 3600 },
    "TokenByIp": { "Permits": 20, "WindowSeconds": 3600 },
    "ReauthByUser": { "Permits": 5, "WindowSeconds": 900 },
    "ApiByUser": { "Permits": 300, "WindowSeconds": 60 },
    "ApiByIp": { "Permits": 600, "WindowSeconds": 60 },
    "AdminApiByUser": { "Permits": 60, "WindowSeconds": 60 }
  },
  "Smtp": {
    "Host": "mail.corp.example",
    "Port": 587,
    "UseStartTls": true,
    "From": "no-reply@corp.example"
  },
  "Gantt": {
    "MaxTasksPerResponse": 5000
  },
  "Tasks": {
    "SoftDeleteRetentionDays": 365,
    "RestoreWindowDays": 30
  },
  "Notifications": {
    "RetentionDays": 180
  },
  "Delay": {
    "ProgressLagThreshold": 20
  },
  "Audit": {
    "RetentionYears": 3
  },
  "Jobs": {
    "Enabled": true
  }
}
