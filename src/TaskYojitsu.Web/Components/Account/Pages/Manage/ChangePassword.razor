@page "/account/manage/change-password"

@using TaskYojitsu.Application.Abstractions

@inject SecurityChanges Changes
@inject IAppDbContext Db

<PageTitle>パスワードの変更 - タスク予実管理</PageTitle>

<h2>パスワードの変更</h2>
<StatusMessage Message="@message" />
<p>パスワードを変えると、この端末以外のログインはすべて取り消されます。</p>
<PasswordHint />
<EditForm Model="Input" FormName="change-password" OnSubmit="OnSubmitAsync" method="post" class="form">
    <input type="hidden" name="username" value="@CurrentUser?.Email" autocomplete="username" />
    <div class="field">
        <label for="password">新しいパスワード</label>
        <InputText @bind-Value="Input.Password" id="password" type="password" autocomplete="new-password" required />
    </div>
    <div class="field">
        <label for="confirm">新しいパスワード（確認）</label>
        <InputText @bind-Value="Input.Confirm" id="confirm" type="password" autocomplete="new-password" required />
    </div>
    <div class="actions">
        <button type="submit" class="btn btn-primary">変更する</button>
    </div>
</EditForm>

@code {
    private string? message;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        await LoadAsync(requireReauth: true);
    }

    private async Task OnSubmitAsync()
    {
        if (CurrentUser is null || !Reauth.IsRecent(HttpContext))
        {
            return;
        }

        if (string.IsNullOrEmpty(Input.Password) || Input.Password != Input.Confirm)
        {
            message = "エラー: " + AuthTexts.PasswordMismatch;
            return;
        }

        foreach (var validator in UserManager.PasswordValidators)
        {
            var check = await validator.ValidateAsync(UserManager, CurrentUser, Input.Password);
            if (!check.Succeeded)
            {
                message = "エラー: " + AuthTexts.ForPasswordErrors(check.Errors);
                return;
            }
        }

        await using (var tx = await Db.Database.BeginTransactionAsync())
        {
            await UserManager.RemovePasswordAsync(CurrentUser);
            var result = await UserManager.AddPasswordAsync(CurrentUser, Input.Password);
            if (!result.Succeeded)
            {
                await tx.RollbackAsync();
                message = "エラー: " + AuthTexts.ForPasswordErrors(result.Errors);
                return;
            }

            await tx.CommitAsync();
        }

        await Changes.AfterChangeAsync(HttpContext, CurrentUser, "auth.password.changed", SessionRevokeReason.PasswordChanged, null);
        RedirectManager.RedirectToWithStatus("/account/manage", "パスワードを変更しました。", HttpContext);
    }

    private sealed class InputModel
    {
        public string? Password { get; set; }
        public string? Confirm { get; set; }
    }
}
