@page "/account/forgot-password"
@attribute [AllowAnonymous]

@using TaskYojitsu.Application.Accounts

@inject PasswordResetService PasswordReset
@inject AuthRateLimiter RateLimiter

<PageTitle>パスワードの再設定 - タスク予実管理</PageTitle>

<div class="auth-card">
    <h1>パスワードの再設定</h1>
    @if (submitted)
    {
        @* 登録の有無にかかわらず、同じ応答にする（NF-AUT-04） *@
        <div class="alert alert-success" role="status">@AuthTexts.ResetRequested</div>
        <p>メールのリンクは 30 分だけ有効です。届かない場合は、迷惑メールのフォルダーも確認してください。</p>
        <p class="auth-links"><a href="/account/login">ログインの画面へ戻る</a></p>
    }
    else
    {
        <StatusMessage Message="@message" />
        <p>登録しているメールアドレスを入力してください。パスワードを再設定するためのリンクを送ります。</p>
        <EditForm Model="Input" FormName="forgot-password" OnSubmit="OnSubmitAsync" method="post" class="form">
            <div class="field">
                <label for="email">メールアドレス</label>
                <InputText @bind-Value="Input.Email" id="email" type="email" autocomplete="username" required />
            </div>
            <div class="actions">
                <button type="submit" class="btn btn-primary">送信</button>
            </div>
        </EditForm>
        <p class="auth-links"><a href="/account/login">ログインの画面へ戻る</a></p>
    }
</div>

@code {
    private bool submitted;
    private string? message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task OnSubmitAsync()
    {
        var ip = ClientIp.Of(HttpContext);
        if (!await RateLimiter.TryAcquireAsync(AuthLimit.ResetRequestByIp, ip?.ToString() ?? "unknown"))
        {
            message = "エラー: " + AuthTexts.TooMany;
            return;
        }

        var email = (Input.Email ?? "").Trim();
        // メールアドレスごとの上限を超えたら、メールを送らずに同じ画面を出す
        if (email.Length > 0 && await RateLimiter.TryAcquireAsync(AuthLimit.ResetRequestByEmail, email))
        {
            await PasswordReset.RequestAsync(email, ip, HttpContext.RequestAborted);
        }

        submitted = true;
    }

    private sealed class InputModel
    {
        public string? Email { get; set; }
    }
}
