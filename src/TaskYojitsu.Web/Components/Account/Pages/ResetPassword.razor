@page "/account/reset-password"
@attribute [AllowAnonymous]

@using TaskYojitsu.Application.Accounts

@inject PasswordResetService PasswordReset
@inject FlowTokenCookie FlowToken
@inject AuthRateLimiter RateLimiter
@inject IdentityRedirectManager RedirectManager

<PageTitle>新しいパスワードの設定 - タスク予実管理</PageTitle>

<div class="auth-card">
    <h1>新しいパスワードの設定</h1>
    @if (done)
    {
        <div class="alert alert-success" role="status">パスワードを変更しました。新しいパスワードでログインしてください。</div>
        <p class="auth-links"><a class="btn btn-primary" href="/account/login">ログイン</a></p>
    }
    else if (user is null)
    {
        <div class="alert alert-error" role="alert">@AuthTexts.LinkExpired</div>
        <p class="auth-links"><a href="/account/forgot-password">もう一度申請する</a></p>
    }
    else
    {
        <StatusMessage Message="@message" />
        <p>@user.Email のパスワードを設定します。</p>
        <PasswordHint />
        <EditForm Model="Input" FormName="reset-password" OnSubmit="OnSubmitAsync" method="post" class="form">
            <input type="hidden" name="username" value="@user.Email" autocomplete="username" />
            <div class="field">
                <label for="password">新しいパスワード</label>
                <InputText @bind-Value="Input.Password" id="password" type="password" autocomplete="new-password" required />
            </div>
            <div class="field">
                <label for="confirm">新しいパスワード（確認）</label>
                <InputText @bind-Value="Input.Confirm" id="confirm" type="password" autocomplete="new-password" required />
            </div>
            <div class="actions">
                <button type="submit" class="btn btn-primary">設定する</button>
            </div>
        </EditForm>
    }
</div>

@code {
    private const string Purpose = "reset";
    private User? user;
    private string? token;
    private bool done;
    private string? message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "token")]
    private string? QueryToken { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (!string.IsNullOrEmpty(QueryToken))
        {
            // リンクのトークンは Cookie に移し、トークンを含まない URL へ移る（履歴に残さない。詳細設計書 6.8）
            if (await RateLimiter.TryAcquireAsync(AuthLimit.TokenByIp, ClientIp.Of(HttpContext)?.ToString() ?? "unknown"))
            {
                FlowToken.Store(HttpContext, Purpose, QueryToken);
            }

            RedirectManager.RedirectTo("/account/reset-password");
            return;
        }

        token = FlowToken.Read(HttpContext, Purpose);
        user = token is null ? null : await PasswordReset.FindUserByTokenAsync(token, HttpContext.RequestAborted);
    }

    private async Task OnSubmitAsync()
    {
        if (user is null || token is null)
        {
            return;
        }

        if (string.IsNullOrEmpty(Input.Password) || Input.Password != Input.Confirm)
        {
            message = "エラー: " + AuthTexts.PasswordMismatch;
            return;
        }

        var result = await PasswordReset.ResetAsync(token, Input.Password, HttpContext.RequestAborted);
        if (!result.Succeeded)
        {
            message = "エラー: " + AuthTexts.ForPasswordErrors(result.Errors);
            return;
        }

        FlowToken.Clear(HttpContext);
        done = true;
    }

    private sealed class InputModel
    {
        public string? Password { get; set; }
        public string? Confirm { get; set; }
    }
}
