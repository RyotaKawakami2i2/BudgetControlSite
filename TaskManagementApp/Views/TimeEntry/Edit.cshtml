@model TaskManagementApp.Models.TimeEntry

@{
    ViewData["Title"] = "作業時間記録編集";
}

<div class="timeentry-edit-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">
                <div class="timeentry-edit-container">
                    <div class="timeentry-edit-header">
                        <div class="timeentry-edit-title">
                            <div class="timeentry-edit-title-icon">
                                <i class="fas fa-edit"></i>
                            </div>
                            作業時間記録編集
                        </div>
                        @if (Model.Job != null)
                        {
                            <p class="timeentry-edit-subtitle">
                                <i class="fas fa-tasks me-2"></i>ジョブ: @Model.Job.Title
                            </p>
                        }
                    </div>
                    
                    <div class="timeentry-edit-body">
                        <form asp-action="Edit" method="post" autocomplete="on">
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="UserId" />
                            
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-enhanced">
                                <div class="alert-icon">
                                    <i class="fas fa-exclamation-triangle"></i>
                                </div>
                                入力内容にエラーがあります。以下をご確認ください。
                            </div>
                            
                            <div class="form-section">
                                <div class="form-section-title">
                                    <div class="form-section-icon">
                                        <i class="fas fa-tasks"></i>
                                    </div>
                                    ジョブ選択
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-list"></i>
                                    </span>
                                    <select asp-for="JobId" class="form-select" required>
                                        <option value="">ジョブを選択してください</option>
                                        @foreach (var job in ViewBag.Jobs)
                                        {
                                            var isSelected = Model.JobId == job.Id;
                                            <option value="@job.Id" selected="@isSelected">
                                                @job.Title
                                            </option>
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="JobId" class="text-danger"></span>
                            </div>
                            
                            <div class="form-section">
                                <div class="form-section-title">
                                    <div class="form-section-icon">
                                        <i class="fas fa-clock"></i>
                                    </div>
                                    作業時間
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="StartTime" class="form-label fw-bold">
                                                <i class="fas fa-play me-2"></i>開始時間
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text">
                                                    <i class="fas fa-calendar-alt"></i>
                                                </span>
                                                <input asp-for="StartTime" type="datetime-local" class="form-control" />
                                            </div>
                                            <span asp-validation-for="StartTime" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="EndTime" class="form-label fw-bold">
                                                <i class="fas fa-stop me-2"></i>終了時間
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text">
                                                    <i class="fas fa-calendar-alt"></i>
                                                </span>
                                                <input asp-for="EndTime" type="datetime-local" class="form-control" />
                                            </div>
                                            <span asp-validation-for="EndTime" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="form-section">
                                <div class="form-section-title">
                                    <div class="form-section-icon">
                                        <i class="fas fa-coffee"></i>
                                    </div>
                                    休憩時間
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-hourglass-half"></i>
                                    </span>
                                    <input asp-for="BreakTime" type="number" step="0.5" min="0" max="24" class="form-control" placeholder="0.0" />
                                    <span class="input-group-text">時間</span>
                                </div>
                                <span asp-validation-for="BreakTime" class="text-danger"></span>
                                <div class="form-text mt-2">
                                    <i class="fas fa-info-circle me-1"></i>
                                    休憩時間を時間単位で入力してください（例: 1.5 = 1時間30分）
                                </div>
                            </div>
                            
                            <div class="form-section">
                                <div class="form-section-title">
                                    <div class="form-section-icon">
                                        <i class="fas fa-pencil-alt"></i>
                                    </div>
                                    作業内容
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-file-alt"></i>
                                    </span>
                                    <textarea asp-for="WorkDescription" class="form-control" rows="4" placeholder="作業内容を詳細に入力してください"></textarea>
                                </div>
                                <span asp-validation-for="WorkDescription" class="text-danger"></span>
                            </div>
                            
                            <div class="d-flex justify-content-between mt-4">
                                <a asp-action="Index" class="btn btn-back">
                                    <i class="fas fa-arrow-left"></i> 戻る
                                </a>
                                <button type="submit" class="btn btn-edit">
                                    <i class="fas fa-save"></i> 更新
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>
    <script>
        // 時間計算の自動化
        document.addEventListener('DOMContentLoaded', function() {
            const startTimeInput = document.querySelector('input[name="StartTime"]');
            const endTimeInput = document.querySelector('input[name="EndTime"]');
            const breakTimeInput = document.querySelector('input[name="BreakTime"]');
            
            // 開始時間と終了時間が変更された時の処理
            function updateBreakTime() {
                if (startTimeInput.value && endTimeInput.value) {
                    const startTime = new Date(startTimeInput.value);
                    const endTime = new Date(endTimeInput.value);
                    
                    if (endTime > startTime) {
                        const totalMinutes = (endTime - startTime) / (1000 * 60);
                        const totalHours = totalMinutes / 60;
                        
                        // デフォルトの休憩時間を設定（8時間以上で1時間、それ以外で30分）
                        let defaultBreak = totalHours >= 8 ? 1.0 : 0.5;
                        
                        if (!breakTimeInput.value || breakTimeInput.value === '0') {
                            breakTimeInput.value = defaultBreak.toFixed(1);
                        }
                    }
                }
            }
            
            startTimeInput.addEventListener('change', updateBreakTime);
            endTimeInput.addEventListener('change', updateBreakTime);
        });
    </script>
} 