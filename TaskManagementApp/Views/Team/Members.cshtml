@model TaskManagementApp.Models.Team

@{
    ViewData["Title"] = "チームメンバー管理";
    var userRole = Context.Session.GetString("UserRole");
}

<style>
    .team-members-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3rem 0;
        margin: -1.5rem -1.5rem 2rem -1.5rem;
        border-radius: 0 0 2rem 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .team-members-card {
        background: white;
        border-radius: 1.5rem;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        border: none;
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .team-members-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 1.5rem;
        position: relative;
    }

    .team-members-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(45deg, rgba(255,255,255,0.1) 0%, transparent 50%, rgba(255,255,255,0.1) 100%);
        pointer-events: none;
    }

    .team-members-body {
        padding: 1.5rem;
    }

    .member-item {
        background: #f8f9fa;
        border-radius: 1rem;
        padding: 1.5rem;
        margin-bottom: 1rem;
        border-left: 4px solid #667eea;
        transition: all 0.3s ease;
        position: relative;
    }

    .member-item:hover {
        transform: translateX(5px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .member-avatar {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.25rem;
        font-weight: 600;
        margin-right: 1rem;
        flex-shrink: 0;
    }

    .member-info {
        flex: 1;
    }

    .member-name {
        font-weight: 600;
        color: #495057;
        font-size: 1.1rem;
        margin-bottom: 0.25rem;
    }

    .member-email {
        color: #6c757d;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .member-email-icon {
        color: #667eea;
    }

    .member-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-remove-member {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        border: none;
        border-radius: 2rem;
        padding: 0.5rem 1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
    }

    .btn-remove-member:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
        background: linear-gradient(135deg, #c82333 0%, #bd2130 100%);
        color: white;
    }

    .add-member-section {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        border-radius: 1.5rem;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 8px 25px rgba(40, 167, 69, 0.3);
    }

    .add-member-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .add-member-icon {
        width: 40px;
        height: 40px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .form-group-enhanced {
        margin-bottom: 1.5rem;
        position: relative;
    }

    .form-label-enhanced {
        font-weight: 600;
        color: white;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-select-enhanced {
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 1rem;
        padding: 1rem 1rem 1rem 3rem;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: rgba(255,255,255,0.1);
        color: white;
        background-image: none;
    }

    .form-select-enhanced:focus {
        border-color: white;
        box-shadow: 0 0 0 0.2rem rgba(255,255,255,0.25);
        background: rgba(255,255,255,0.2);
        color: white;
    }

    .form-select-enhanced option {
        background: #28a745;
        color: white;
    }

    .form-control-icon {
        position: absolute;
        left: 1rem;
        top: 3.5rem;
        color: rgba(255,255,255,0.8);
        z-index: 10;
    }

    .btn-add-member {
        background: white;
        color: #28a745;
        border: none;
        border-radius: 2rem;
        padding: 0.75rem 2rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        box-shadow: 0 5px 15px rgba(255,255,255,0.3);
    }

    .btn-add-member:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255,255,255,0.4);
        background: #f8f9fa;
        color: #28a745;
    }

    .btn-back {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        color: white;
        border: none;
        border-radius: 2rem;
        padding: 0.75rem 2rem;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        box-shadow: 0 5px 15px rgba(108, 117, 125, 0.4);
    }

    .btn-back:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(108, 117, 125, 0.6);
        color: white;
    }

    .empty-members {
        text-align: center;
        padding: 3rem;
        color: #6c757d;
    }

    .empty-members-icon {
        font-size: 4rem;
        color: #dee2e6;
        margin-bottom: 1rem;
    }

    .member-stats {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        flex: 1;
        margin: 0 0.5rem;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: #667eea;
        margin-bottom: 0.5rem;
    }

    .stat-label {
        color: #6c757d;
        font-weight: 500;
    }

    .no-available-users {
        background: rgba(255,255,255,0.1);
        border-radius: 1rem;
        padding: 1.5rem;
        text-align: center;
        border: 2px dashed rgba(255,255,255,0.3);
    }
</style>

<div class="team-members-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-4 fw-bold mb-3">
                    <i class="fas fa-users me-3"></i>@ViewBag.TeamName - メンバー管理
                </h1>
                <p class="lead mb-0">チームメンバーの追加・削除を行います</p>
            </div>
            <div class="col-md-4 text-md-end">
                <a asp-action="Index" class="btn-back">
                    <i class="fas fa-arrow-left"></i> チーム一覧に戻る
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="member-stats">
        <div class="stat-card">
            <div class="stat-number">@Model.TeamUsers.Count</div>
            <div class="stat-label">現在のメンバー数</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@ViewBag.AvailableUsers.Count</div>
            <div class="stat-label">追加可能なユーザー数</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@Model.TeamLeader</div>
            <div class="stat-label">チームリーダー</div>
        </div>
    </div>

    <div class="row">
        <!-- 現在のメンバー -->
        <div class="col-lg-8">
            <div class="team-members-card">
                <div class="team-members-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-users me-2"></i>現在のメンバー (@Model.TeamUsers.Count 人)
                    </h5>
                </div>
                <div class="team-members-body">
                    @if (Model.TeamUsers == null || !Model.TeamUsers.Any())
                    {
                        <div class="empty-members">
                            <div class="empty-members-icon">
                                <i class="fas fa-users"></i>
                            </div>
                            <h4 class="text-muted mb-3">メンバーが登録されていません</h4>
                            <p class="text-muted">右側のフォームからメンバーを追加してください</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var teamUser in Model.TeamUsers)
                        {
                            <div class="member-item d-flex align-items-center">
                                <div class="member-avatar">
                                    @(teamUser.User?.Name?.Substring(0, 1) ?? "?")
                                </div>
                                <div class="member-info">
                                    <div class="member-name">@(teamUser.User?.Name ?? "")</div>
                                    <div class="member-email">
                                        <i class="fas fa-envelope member-email-icon"></i>
                                        @(teamUser.User?.Email ?? "")
                                    </div>
                                </div>
                                @if (userRole == "Admin" || Model.TeamLeader == Context.Session.GetString("UserName"))
                                {
                                    <div class="member-actions">
                                        <form asp-action="RemoveMember" method="post" style="display: inline;">
                                            <input type="hidden" name="teamId" value="@ViewBag.TeamId" />
                                            <input type="hidden" name="userId" value="@teamUser.UserId" />
                                            <button type="submit" class="btn-remove-member" 
                                                    onclick="return confirm('@(teamUser.User?.Name ?? "") をチームから削除しますか？')">
                                                <i class="fas fa-user-minus"></i> 削除
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- メンバー追加 -->
        @if (userRole == "Admin" || Model.TeamLeader == Context.Session.GetString("UserName"))
        {
            <div class="col-lg-4">
                <div class="add-member-section">
                    <div class="add-member-header">
                        <div class="add-member-icon">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <h5 class="mb-0">メンバー追加</h5>
                    </div>
                    
                    @if (!((List<TaskManagementApp.Models.User>)ViewBag.AvailableUsers).Any())
                    {
                        <div class="no-available-users">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>追加可能なユーザーがいません</strong>
                            <p class="mb-0 mt-2">すべてのユーザーが既にこのチームに参加しています</p>
                        </div>
                    }
                    else
                    {
                        <form asp-action="AddMember" method="post">
                            <input type="hidden" name="teamId" value="@ViewBag.TeamId" />
                            <div class="form-group-enhanced">
                                <label for="userId" class="form-label-enhanced">
                                    <i class="fas fa-user me-1"></i>追加するユーザー
                                </label>
                                <i class="fas fa-user form-control-icon"></i>
                                <select name="userId" id="userId" class="form-select-enhanced" required>
                                    <option value="">ユーザーを選択してください</option>
                                    @foreach (var user in ViewBag.AvailableUsers)
                                    {
                                        <option value="@user.Id">@user.Name (@user.Email)</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn-add-member w-100">
                                <i class="fas fa-user-plus"></i> メンバー追加
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // 削除確認のためのJavaScript
        function confirmRemoveMember(userName) {
            return confirm(`${userName} をチームから削除しますか？`);
        }
    </script>
} 